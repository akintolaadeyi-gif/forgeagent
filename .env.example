# Copy to .env (install.ps1 does this). All variables are optional - these are the defaults.

# --- API server (bind to localhost; do not expose without setting FORGE_API_TOKEN) ---
FORGE_HOST=127.0.0.1
FORGE_PORT=8000
# If set, every /api request must send header X-Forge-Token (the UI stores it in localStorage key "forge_token")
FORGE_API_TOKEN=

# --- Local model server (llama.cpp, OpenAI-compatible) ---
FORGE_LLM_BASE_URL=http://127.0.0.1:8080/v1
FORGE_LLM_API_KEY=sk-local

# --- Optional: let ForgeAgent launch/stop llama-server from the Settings screen ---
# FORGE_LLAMA_SERVER_PATH=/usr/local/bin/llama-server   (default: C:\AI\llama.cpp\llama-server.exe on Windows, "llama-server" on PATH elsewhere)
# FORGE_MODELS_DIR=/home/you/models   (default: C:\AI\Models on Windows, ~/models elsewhere)
# 99 = offload as many layers as fit; llama.cpp auto-fits to free VRAM and spills the rest to CPU
FORGE_LLAMA_GPU_LAYERS=99
FORGE_LLAMA_EXTRA_ARGS=

# --- Storage (SQLite database, logs, screenshots) ---
FORGE_DATA_DIR=./data
# FORGE_DATABASE_URL=sqlite:///C:/path/to/forge.db

# --- Browser dev origins allowed by CORS (only needed for `npm run dev`) ---
# FORGE_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
